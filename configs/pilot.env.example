# Optional environment variables for local Stage 3 pilot runs.
# Source only after creating the output directory: mkdir -p ./runs
# These settings are not read automatically by the Python scripts.
VVCRL_MODE=zero
VVCRL_DELTA=0
VVCRL_LOG=./runs/pilot.jsonl
